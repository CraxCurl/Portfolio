# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Resend API key — https://resend.com/api-keys
# Without this the contact form returns "the form isn't wired up yet".
RESEND_API_KEY=

# Sender identity. Must be on a domain verified in the Resend dashboard,
# otherwise Resend rejects the send.
CONTACT_FROM_EMAIL="Vinayak Tripathi <portfolio@stigz.xyz>"

# Inbox that contact-form messages are delivered to.
CONTACT_TO_EMAIL=vinayak02tripathi2006@gmail.com
